{
  "manifest_version": 3,
  "name": "NarWal",
  "version": "1.0.8",
  "description": "Record a narrated walkthrough of one tab: page evidence and your microphone, saved on this computer.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": { "service_worker": "dist/sw.js", "type": "module" },
  "permissions": ["offscreen", "scripting", "webNavigation", "tabs", "storage", "unlimitedStorage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_title": "NarWal",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "commands": {
    "stop-recording": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Stop the recording" },
    "focus-controls": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "Move the keyboard to the recording controls on the page" },
    "mark-focused": { "suggested_key": { "default": "Alt+Shift+M" }, "description": "Mark the focused item while recording" }
  }
}
